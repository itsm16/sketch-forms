# Postgres connection string (Neon, Supabase, Vercel Postgres, local Docker, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev"

# Secret used to sign auth tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional. Leave empty in the browser app to use the built-in /api/trpc route.
NEXT_PUBLIC_API_URL=""

# Only used by the standalone Express API in apps/api (optional).
PORT="8000"
BASE_URL="http://localhost:3000"
